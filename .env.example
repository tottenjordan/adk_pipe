GOOGLE_GENAI_USE_ENTERPRISE=1
# REQUIRED. Your GCP project ID. Nothing in the code hardcodes a project: the
# agents, deploy scripts (deploy_agent.py, test_deployment.py, integration_test.py,
# create_session_engine.py) and the Cloud Run Functions all read it from here /
# the environment. The Cloud Run Functions do NOT read this file — pass it with
# `--set-env-vars` (see deployment/README.md → Required environment); they raise
# at first use if it's unset.
GOOGLE_CLOUD_PROJECT="<this-my-project-id>"
# gemini-3.x models are ONLY served from the `global` Vertex location
# (us-central1 returns 404). Regional resources (BigQuery, GCS, PubSub,
# Agent Engine) use us-central1 — see GCP_REGION below.
GOOGLE_CLOUD_LOCATION=global
# Region for regional resources (Agent Engine, Cloud Run, Pub/Sub). Default us-central1.
GCP_REGION=us-central1
# Numeric project number (`gcloud projects describe $GOOGLE_CLOUD_PROJECT
# --format='value(projectNumber)'`). Required by deploy_agent.py (--delete) and
# shipped to the agents; optional for the Cloud Run Functions, which fall back to
# GOOGLE_CLOUD_PROJECT for resource paths (Pub/Sub + Vertex accept either).
GOOGLE_CLOUD_PROJECT_NUMBER=<12345678910>

# Which model bucket the campaign_researcher sub-agent runs on. Leave UNSET for
# production behavior (defaults to `global_altbucket`: gemini-3.5-flash @ global, a
# distinct quota bucket from the trend half — PR #101 spread). Alternate arm
# `global_3x` (shares the trend buckets) is for comparison runs — see
# experiments/quota_spread/. Resolved by creative_agent/config.py.
# CAMPAIGN_RESEARCH_PLACEMENT=global_altbucket

# Failover model for the Pro (critic_model) producers on quota 429/5xx (ADK
# FallbackModel). Leave UNSET for the default (gemini-3.8-flash, the worker
# bucket); set to empty to disable Pro->flash failover. Cloud Run reads it at
# service start; Agent Engine pickles the agent at deploy time, so the deployer's
# local env decides (redeploy with CRITIC_FALLBACK_MODEL="" to disable there).
# CRITIC_FALLBACK_MODEL=gemini-3.8-flash


# Cloud Storage
# Bare bucket name (no gs:// prefix). The gs:// form is derived from this in
# agent_common/config.py (GCS_BUCKET) — there is no separate BUCKET var.
GOOGLE_CLOUD_STORAGE_BUCKET=this-my-bucket-name


# PubSub
CREATIVE_TOPIC_NAME=creative-eventarc-topic
# Worker topic the CRF orchestrator publishes to (config default matches this value).
CREATIVE_WORKER_TOPIC_NAME=creative-worker-queue-topic


# Cloud Run Functions
BASE_IMAGE=python313

CREATIVE_CRF_NAME=creative-trawler-crf
CRF_ENTRYPOINT=crf_entrypoint
CREATIVE_TRIGGER_NAME=creative-eventarc-trigger

CREATIVE_WORKER_CRF_NAME=creative-worker-crf
CREATIVE_WORKER_ENTRYPOINT=agent_worker_entrypoint
CREATIVE_WORKER_TRIGGER_NAME=creative-worker-starter-trigger

# Base user ID the CRF worker creates Agent Engine sessions under (each row runs
# as `<AGENT_WORKER_USER_ID>_<row index>`). Optional; default `crf_worker`.
AGENT_WORKER_USER_ID=crf_worker
# Optional CRF knobs (defaults shown): stale-PROCESSING reaper cutoff (must exceed
# the worker's 1800s timeout), attempts before a reaped row goes FAILED, and extra
# comma-separated BQ tables the CRFs may target beyond BQ_TABLE_TARGETS.
# REAP_STALE_PROCESSING_MINUTES=45
# MAX_PROCESSING_ATTEMPTS=3
# CRF_EXTRA_ALLOWED_TABLES=


# BigQuery 
BQ_PROJECT_ID="<this-my-project-bq-id>"
BQ_DATASET_ID='trend_trawler'
BQ_TABLE_TARGETS='target_trends_crf'
BQ_TABLE_CREATIVES='trend_creatives'
BQ_TABLE_EVALS='creative_evals'


# Agent Engine (leave blank)
CREATIVE_AGENT_ENGINE_ID=""
SCOUT_AGENT_ENGINE_ID=""
INTERACTIVE_AGENT_ENGINE_ID=""


# Optional Cloud Trace export for the Cloud Run api (default off). When enabling,
# also disable ADK's prompt/response capture in spans (ADK defaults it to true).
# ADK_OTEL_TO_CLOUD=true
# ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false


# campaign metadata
BRAND="Paul Reed Smith (PRS)"
TARGET_AUDIENCE="millennials who follow jam bands (e.g., Widespread Panic and Phish), respond positively to nostalgic messages"
TARGET_PRODUCT="PRS SE CE24 Electric Guitar"
KEY_SELLING_POINT="The 85/15 S Humbucker pickups deliver a wide tonal range, from thick humbucker tones to clear single-coil sounds, making the guitar suitable for various genres."
TARGET_SEARCH_TREND="tswift engaged"