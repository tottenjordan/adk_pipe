# Agent Engine deploy profile (committed, NON-SECRET) for deployment/cloudbuild.agents.yaml.
#
# deploy_agent.py bakes the deployer's environment into the pickled agents
# (ENV_VAR_DICT is shipped as the engine's env vars; CRITIC_FALLBACK_MODEL,
# MODEL_ARMOR_*, MODEL_REQUEST_TIMEOUT_SECONDS, MODEL_LOCATION ... are read at
# agent import). The Cloud Build deploy runs from `env -i` + this file only
# (deployment/cloudbuild_env.sh), so every value an engine gets is written here,
# reviewed in a PR, and never inherited from a deployer shell.
#
# Rules: plain KEY=value lines (sourced by bash AND read by python-dotenv; quote
# values with spaces in single quotes). Never add *_AGENT_ENGINE_ID, BUCKET or
# GCS_BUCKET_NAME (the wrapper refuses them) or anything secret (use Secret
# Manager + availableSecrets in the build config instead; nothing needs it today).
# Every ENV_VAR_DICT key must be listed (tests/test_cloudbuild_agents.py).
# Defaults below match the code / .env.example as of 2026-10-12.

# --- project / location (deploy inputs; the wrapper checks the project = the build's)
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=hybrid-vertex
GOOGLE_CLOUD_PROJECT_NUMBER=934903580331
# gemini-3.x is served only from `global`; Agent Engine is regional (GCP_REGION).
GOOGLE_CLOUD_LOCATION=global
GCP_REGION=us-central1
MODEL_LOCATION=global
# Bare bucket name: the engine's staging bucket and the agents' output bucket.
GOOGLE_CLOUD_STORAGE_BUCKET=trend-trawler-deploy-ae

# --- BigQuery
BQ_PROJECT_ID=hybrid-vertex
BQ_DATASET_ID=trend_trawler
BQ_TABLE_TARGETS=target_trends_crf
BQ_TABLE_CREATIVES=trend_creatives
BQ_TABLE_EVALS=creative_evals
BQ_TABLE_RATINGS=creative_ratings

# --- models / timeouts (pickled at deploy)
# Pro -> flash failover target; an empty value would DISABLE failover.
CRITIC_FALLBACK_MODEL=gemini-3.8-flash
CAMPAIGN_RESEARCH_PLACEMENT=global_altbucket
MODEL_REQUEST_TIMEOUT_SECONDS=240
FLASH_MODEL_REQUEST_TIMEOUT_SECONDS=90
EVAL_MODEL=gemini-3.1-pro-preview
EVAL_MAX_WORKERS=2
EVAL_MAX_VISUAL_WAVE_WORKERS=4
IMAGE_SIZE=2K
IMAGE_ASPECT_RATIO_DEFAULT=9:16

# --- Model Armor (off in prod: empty template = no plugin)
MODEL_ARMOR_TEMPLATE=
MODEL_ARMOR_RESPONSE_TEMPLATE=
MODEL_ARMOR_FAIL_CLOSED=true

# --- creative quality knobs
BRIEF_REVISION_ROUNDS=1
COPY_REVISION_ROUNDS=1
CONCEPT_REVISION_ROUNDS=1
IMAGE_QA_ENABLED=true
IMAGE_QA_MAX_RERENDERS=1
IMAGE_QA_MAX_RERENDERS_PER_RUN=2
IMAGE_QA_MODEL=gemini-3.8-flash
BRAND_HISTORY_ENABLED=true
BRAND_HISTORY_RUNS=5

# --- rating learning (opt-in per run)
RATING_LEARNING_ENABLED=true
RATING_LEARNING_EFFECTS=guidance,styles,checks
RATING_LEARNING_MIN_RATINGS=8
RATING_STYLE_MIN=3
RATING_REASON_MIN=3
RATING_LEARNING_WINDOW_DAYS=90

# --- person casting
PERSON_SAFE_STYLES='Candid 35mm film photo,Photoreal / editorial,Cinematic film still,3D character render,Comic panel,2D flat / vector cartoon,Collage / mixed-media'
MAX_CAST_CONCEPTS=2

# --- dates / trend situation / timely slot
TREND_TIMEZONE=America/New_York
TREND_STATE_ENABLED=true
TREND_EVENT_WINDOW_DAYS=7
TIMELY_VALID_HOURS_AFTER=48
MAX_TIMELY_CONCEPTS=1
