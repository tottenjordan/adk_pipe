# Root build context of the api image (Dockerfile). The bandit image
# (bandit_stack/bandit_serving/Dockerfile, endpoint + traffic job) uses its own
# bandit_stack/bandit_serving/Dockerfile.dockerignore instead.
.git
.venv
**/__pycache__
**/*.pyc
**/.adk
**/.env*
.vscode
.github
.claude
.agents
.pytest_cache
.ruff_cache
.mypy_cache
frontend
node_modules
outputs
docs
tests
experiments
notebook-examples
imgs
bandit_stack
cloud_functions
# Build configs: editing them must not invalidate the api's source layer.
cloudbuild.yaml
deployment/cloudbuild.gcloudignore
