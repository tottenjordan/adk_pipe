.venv
.python-version
output/*
*.env
# The committed, non-secret Agent Engine deploy profile (deployment/cloudbuild.agents.yaml).
!deployment/deploy.env
*.pyc
**/__pycache__/
__pycache__/
# pytest cache, incl. the persistent JAX compile cache (.pytest_cache/jax, set in
# tests/conftest.py), which JAX may create before pytest writes its own .gitignore
.pytest_cache/
a_stash/
**cloud_functions/creative_fanout/message.json
.adk
.adk/*
.next/*

# local scratch log (e.g. from headless smoke runs)
err.log

# creative_eval test-run output (generated by creative_eval/run_eval_test.py)
creative_eval_test_report.json

# PaperBanana figure-generation scratch (keep the committed diagrams under
# docs/architecture/*.png, ignore the transient per-run working dirs)
outputs/
docs/architecture/run_*/.crf-venv/

# Internal reference notebooks (bandit simulations) — never commit
notebook-examples/

# Local Claude Code settings/state (per-user, not shared)
.claude/

# Person reference calibration: renders + per-render CSV show real people; only the summary is committable
experiments/person_reference/results/*
!experiments/person_reference/results/summary.md

# Temperature A/B: real arm URLs/revisions (arms.example.json is the template) and
# per-run records (full session state)
experiments/temperature_ab/arms.json
experiments/temperature_ab/results/
experiments/temperature_ab/pilot/
experiments/temperature_ab/run.log
